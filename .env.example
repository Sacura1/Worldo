# Copy to ignored .env for local development. Use Fly secrets in production.
# Never use VITE_ for server credentials; never commit private keys.
PORT=3000
PUBLIC_URL=http://localhost:3000
# Optional alias: if set, APP_ORIGIN must equal PUBLIC_URL.
# APP_ORIGIN=http://localhost:3000
# Set the pooled Neon connection string through Fly secrets for production.
DATABASE_URL=
# Select testnet for free test tokens, mainnet only after production approval.
NEAR_NETWORK=testnet
ENABLE_TESTNET=false
ENABLE_MAINNET=false
# testnet-wallet keeps test-only keys in the browser; social uses NEAR Auth.
NEAR_AUTH_MODE=testnet-wallet
# Blank RPC/Auth values derive the selected network’s official defaults.
# Mainnet application approval: https://docs.auth.near.org/home/apply
NEAR_AUTH_CLIENT_ID=
# Replace defaults only with the issuer/signing audience/guard approved for this app.
NEAR_AUTH_DOMAIN=
NEAR_AUTH_AUDIENCE=
NEAR_AUTH_GUARD_ID=
NEAR_CONTRACT_ID=
# Defaults: testnet https://test.rpc.fastnear.com; mainnet https://free.rpc.fastnear.com
NEAR_RPC_URL=
# Local sponsorship requires a funded operator key and daily budget.
# Social signing also needs SIGN_DEPOSIT; mainnet always requires DATABASE_URL.
NEAR_RELAYER_ACCOUNT_ID=
NEAR_RELAYER_PRIVATE_KEY=
NEAR_RELAYER_SIGN_DEPOSIT_YOCTO=
NEAR_RELAYER_DAILY_BUDGET_YOCTO=
# Alternative operator-controlled reference relayer base URL, not a public default.
NEAR_AUTH_RELAYER_URL=
NEAR_AUTH_RELAYER_TOKEN=
# Live harvest oracle and registered merchant accounts.
NEAR_ORACLE_ACCOUNT_ID=
NEAR_ORACLE_PRIVATE_KEY=
NEAR_REFINERY_ACCOUNT=
NEAR_FOUNDRY_ACCOUNT=
NEAR_SAWMILL_ACCOUNT=
NEAR_DEPOT_ACCOUNT=
# Optional server-side 1Click API credential.
NEAR_INTENTS_API_KEY=

# Optional NEAR AI Cloud dialogue. Without a key, authored local dialogue is used.
# Get a key at https://cloud.near.ai/ — never expose it through VITE_.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8
