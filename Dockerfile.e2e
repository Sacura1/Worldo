FROM node:24-bookworm
SHELL ["/bin/bash", "-c"]
WORKDIR /qa
COPY package.json package-lock.json ./
RUN npm ci
RUN npx playwright install --with-deps chromium
COPY playwright.config.ts ./
COPY e2e ./e2e
COPY shared ./shared
COPY scripts/export-qa.mjs ./scripts/export-qa.mjs
ARG E2E_BASE_URL=https://lowland-near.fly.dev
ARG E2E_SCOPE=all
ENV CI=true E2E_BASE_URL=${E2E_BASE_URL} E2E_SCOPE=${E2E_SCOPE} PLAYWRIGHT_JSON_OUTPUT_FILE=/qa/qa-report.json
ARG QA_RUN_ID=initial
# Preserve the real test status. Artifact lines go to a redirected build log,
# where the caller can decode selected screenshots without a QA deployment.
RUN echo "QA run: ${QA_RUN_ID}" && mkdir -p test-results && \
    (npx playwright test --reporter=list,json 2>&1 | tee /qa/qa-run.log; \
     status=${PIPESTATUS[0]}; \
     node scripts/export-qa.mjs "$status"; exit "$status")
