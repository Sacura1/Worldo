# Full local play needs no chain keys. Enable only after deploying the city contract.
CHAIN_SYNC_ENABLED=false
# Copy this file to ignored .env.testnet. Build, then run npm run start:testnet.
# This profile is complete: it does not read .env or inherit application settings.
# Never use VITE_ for server credentials; never commit private keys.
PORT=3000
# Production product behavior also applies when previewed with the dev server.
APP_MODE=production
PUBLIC_URL=http://localhost:3000
# Optional alias: if set, APP_ORIGIN must equal PUBLIC_URL.
# APP_ORIGIN=http://localhost:3000
# Set the pooled Neon connection string through Fly secrets for production.
DATABASE_URL=
# Submission uses real testnet transactions and social login; no real funds.
NEAR_NETWORK=testnet
ENABLE_TESTNET=true
# Lets people press Play as guest and get a throwaway testnet account. Testnet only.
GUEST_PLAY_ENABLED=true
ENABLE_MAINNET=false
NEAR_AUTH_MODE=social
# Without Neon, testnet alone may use durable storage on one app machine.
# Fly uses its mounted /data directory; local video recording can use .local/games.
LOCAL_DATA_DIR=.local/testnet
TESTNET_SINGLE_PROCESS=true
# Blank RPC/Auth values derive the selected network’s official defaults.
# Testnet public credentials are derived automatically. Its public client allows
# localhost:3000; a deployed origin needs an allowed Auth0 callback.
# Later mainnet approval: https://docs.auth.near.org/home/apply
NEAR_AUTH_CLIENT_ID=
# Replace defaults only with the issuer/signing audience/guard approved for this app.
NEAR_AUTH_DOMAIN=
NEAR_AUTH_AUDIENCE=
NEAR_AUTH_GUARD_ID=
NEAR_CONTRACT_ID=
# Testnet default: https://test.rpc.fastnear.com
# Mainnet default: https://free.rpc.fastnear.com
NEAR_RPC_URL=
# Local sponsorship requires a funded operator key and daily budget.
# Social signing also needs SIGN_DEPOSIT; mainnet always requires DATABASE_URL.
NEAR_RELAYER_ACCOUNT_ID=
NEAR_RELAYER_PRIVATE_KEY=
# Verified for v1.signer-prod.testnet v3.18.0; reverify before mainnet/upgrades.
NEAR_RELAYER_SIGN_DEPOSIT_YOCTO=1
NEAR_RELAYER_DAILY_BUDGET_YOCTO=
# Optional development/reference relayer. Production requires the locally managed
# operator above so readiness can validate its key, funds and spending budget.
NEAR_AUTH_RELAYER_URL=
NEAR_AUTH_RELAYER_TOKEN=
# City settlement oracle and three mayor accounts. Each mayor signs batch decisions.
NEAR_ORACLE_ACCOUNT_ID=
NEAR_ORACLE_PRIVATE_KEY=
NEAR_REFINERY_ACCOUNT=
NEAR_REFINERY_PRIVATE_KEY=
NEAR_MOTOR_ACCOUNT=
NEAR_MOTOR_PRIVATE_KEY=
NEAR_HARBOR_ACCOUNT=
NEAR_HARBOR_PRIVATE_KEY=
# Optional server-side 1Click API credential.
NEAR_INTENTS_API_KEY=

# NEAR AI Cloud dialogue. Without a key, AI chat is explicitly unavailable.
# Get a key at https://cloud.near.ai/ — never expose it through VITE_.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
NEAR_AI_DAILY_REQUEST_LIMIT=100

# Optional ElevenLabs speech. Keys and voice IDs stay on the server.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_DAILY_CHARACTER_LIMIT=1000
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_HALE=
ELEVENLABS_VOICE_IMANI=
ELEVENLABS_VOICE_ROSA=
