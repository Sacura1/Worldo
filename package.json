{
  "name": "lowland",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx scripts/start.mjs",
    "start:testnet": "node --import tsx scripts/start-network.ts testnet",
    "start:mainnet": "node --import tsx scripts/start-network.ts mainnet",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.2.0",
    "@defuse-protocol/one-click-sdk-typescript": "^0.1.26",
    "@fontsource/barlow-condensed": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "@neondatabase/serverless": "^1.0.2",
    "bs58": "^6.0.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "near-api-js": "^5.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.0",
    "@near-js/transactions": "2.5.1",
    "@near-js/crypto": "2.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0",
    "esbuild": "^0.28.2"
  }
}
